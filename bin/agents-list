#!/usr/bin/env python3
"""List local coding sessions by last activity, without changing their history."""

import argparse
from collections import OrderedDict
from datetime import datetime, timezone
import json
import os
import re
from pathlib import Path
import shlex
import sqlite3
import subprocess
import sys


def timestamp(value):
    if isinstance(value, (int, float)):
        return value / 1000 if value > 100_000_000_000 else value
    if value:
        # Python 3.9 and 3.10 only parse fractions of exactly three or six digits.
        value = re.sub(r"\.(\d+)", lambda m: "." + m.group(1)[:6].ljust(6, "0"), value.replace("Z", "+00:00"))
        return datetime.fromisoformat(value).timestamp()
    return 0


def database_rows(path, query):
    if not path.exists():
        return []
    with sqlite3.connect(path.as_uri() + "?mode=ro", uri=True) as db:
        db.row_factory = sqlite3.Row
        return [dict(row) for row in db.execute(query)]


def codex_sessions(home):
    index = {}
    index_path = home / "session_index.jsonl"
    if index_path.exists():
        with index_path.open() as stream:
            for line in stream:
                try:
                    entry = json.loads(line)
                except ValueError:
                    continue
                index[entry["id"]] = entry
    rows = {}
    for path in (home / "sessions").rglob("*.jsonl"):
        with path.open() as stream:
            try:
                header = json.loads(stream.readline())
            except ValueError:
                continue
        if header.get("type") != "session_meta":
            continue
        meta = header["payload"]
        if "subagent" in json.dumps(meta.get("source", "")):
            continue
        session = meta["id"]
        entry = index.get(session, {})
        row = {"client": "codex", "id": session, "cwd": meta.get("cwd", ""),
               "title": entry.get("thread_name", ""),
               "scripted": meta.get("originator") == "codex_exec",
               "activity": max(timestamp(entry.get("updated_at")), path.stat().st_mtime)}
        if not row["title"]:
            row["first_prompt"] = first_prompt(transcript_edges(path), "codex")
        if session not in rows or row["activity"] > rows[session]["activity"]:
            rows[session] = row
    return list(rows.values())


def transcript_edges(path):
    # Bounded reads avoid loading long tool outputs just to find session metadata.
    with path.open("rb") as stream:
        head = stream.read(131072)
        size = stream.seek(0, 2)
        if size <= len(head):
            chunks = [head]
        else:
            stream.seek(max(0, size - 131072))
            chunks = [head, stream.read().partition(b"\n")[2]]
    for chunk in chunks:
        for line in chunk.splitlines():
            try:
                yield json.loads(line)
            except (ValueError, UnicodeDecodeError):
                continue


def first_prompt(events, client):
    for event in events:
        for role, text in written_blocks(event, client) if isinstance(event, dict) else []:
            if role == "user":
                return clean(text)[:200]
    return ""


def claude_sessions(home):
    rows = []
    for path in (home / "projects").glob("*/*.jsonl"):
        row = {"client": "claude", "id": path.stem, "cwd": "", "title": "",
               "activity": 0}
        sidechain, entrypoints = False, set()
        custom = generated = slug = prompt = ""
        for event in transcript_edges(path):
            sidechain = sidechain or event.get("isSidechain", False)
            entrypoints.add(event.get("entrypoint"))
            row["cwd"] = event.get("cwd") or row["cwd"]
            custom = event.get("customTitle") or custom
            generated = event.get("aiTitle") or generated
            slug = slug or event.get("slug", "")
            prompt = prompt or first_prompt([event], "claude")
            row["activity"] = max(row["activity"], timestamp(event.get("timestamp")))
        # Same order as Claude Code's own resume list.
        row["title"] = custom or generated or slug
        if not row["title"]:
            row["first_prompt"] = prompt
        # `claude -p` records sdk-cli; resuming the session interactively adds cli.
        row["scripted"] = "sdk-cli" in entrypoints and "cli" not in entrypoints
        if not sidechain:
            row["activity"] = row["activity"] or path.stat().st_mtime
            rows.append(row)
    return rows


def opencode_sessions(home):
    path = home / "opencode" / "opencode.db"
    if not path.exists():
        return []
    tables = database_rows(path, "SELECT name FROM sqlite_master WHERE type = 'table'")
    rows = {}
    active_tables = ("session_v2",) if {"name": "session_v2"} in tables else ("session",)
    for table in active_tables:
        if {"name": table} not in tables:
            continue
        for row in database_rows(path, f"""
            SELECT id, directory AS cwd, title, time_updated FROM {table}
            WHERE parent_id IS NULL AND time_archived IS NULL
        """):
            row["client"] = "opencode"
            row["activity"] = timestamp(row.pop("time_updated"))
            rows[row["id"]] = row
    return list(rows.values())


def cursor_sessions(home):
    rows = []
    for path in (home / "chats").glob("*/*/meta.json"):
        try:
            meta = json.loads(path.read_text())
        except (OSError, ValueError):
            continue
        if meta.get("isSubagent") or not meta.get("hasConversation") or not meta.get("cwd"):
            continue
        if re.match(r"^/(?:private/)?tmp/claude-\d+/(?:.*/)?scratchpad(?:/|$)", meta["cwd"]):
            continue
        database = path.with_name("store.db")
        title = ""
        if database.exists():
            mode = "?mode=ro" if database.with_name("store.db-wal").exists() else "?mode=ro&immutable=1"
            try:
                with sqlite3.connect(database.as_uri() + mode, uri=True) as db:
                    db.create_function("decode_meta", 1, lambda value: bytes.fromhex(value).decode())
                    result = db.execute("SELECT json_extract(decode_meta(value), '$.name') FROM meta WHERE key = '0'").fetchone()
                    title = result[0] if result else ""
            except sqlite3.Error:
                pass
        rows.append({"client": "cursor", "id": path.parent.name, "cwd": meta["cwd"],
                     "title": title, "activity": timestamp(meta.get("updatedAtMs")) or path.stat().st_mtime})
    return rows


def clean(value):
    return " ".join("".join(c for c in str(value or "") if c.isprintable()).split())


def text_blocks(content):
    if isinstance(content, str):
        return content
    if not isinstance(content, list):
        return ""
    return "\n\n".join(block.get("text", "") for block in content
                         if isinstance(block, dict) and block.get("type") in
                         ("text", "input_text", "output_text") and isinstance(block.get("text"), str))


def preview_date(value):
    try:
        return datetime.fromtimestamp(timestamp(value), timezone.utc).isoformat() if value else ""
    except (ValueError, TypeError, OverflowError, OSError):
        return ""


def transcript_preview(path, client):
    messages = OrderedDict()
    fallback = []
    with path.open("rb") as stream:
        size = stream.seek(0, 2)
        stream.seek(max(0, size - 4 * 1024 * 1024))
        if stream.tell():
            stream.readline(4 * 1024 * 1024)
        data = stream.read(4 * 1024 * 1024)
    for index, line in enumerate(data.splitlines()):
        try:
            event = json.loads(line)
        except (ValueError, UnicodeDecodeError):
            continue
        if not isinstance(event, dict):
            continue
        if client == "claude":
            if event.get("isSidechain") or event.get("isMeta"):
                continue
            message = event.get("message", {})
            if not isinstance(message, dict):
                continue
            role = message.get("role")
            text = text_blocks(message.get("content"))
            key = message.get("id") or event.get("uuid") or str(index)
        else:
            message = event.get("payload", {})
            if not isinstance(message, dict):
                continue
            if event.get("type") == "event_msg" and message.get("type") in ("user_message", "agent_message"):
                fallback.append({"role": "user" if message["type"] == "user_message" else "assistant",
                                 "text": message.get("message", ""), "timestamp": event.get("timestamp", "")})
            if event.get("type") != "response_item" or message.get("type") != "message":
                continue
            role = message.get("role")
            text = text_blocks(message.get("content"))
            key = message.get("id") or str(index)
        if role not in ("user", "assistant") or not text.strip():
            continue
        if key in messages:
            previous = messages[key]["text"]
            if previous.startswith(text):
                text = previous
            elif not text.startswith(previous):
                text = previous + "\n\n" + text
        messages[key] = {"role": role, "text": text, "timestamp": event.get("timestamp", "")}
    return list(messages.values())[-6:] or fallback[-6:]


def opencode_preview(home, session):
    path = home / "opencode/opencode.db"
    if not path.exists():
        raise ValueError("OpenCode's saved database is unavailable.")
    with sqlite3.connect(path.as_uri() + "?mode=ro", uri=True) as db:
        db.row_factory = sqlite3.Row
        tables = {r[0] for r in db.execute("SELECT name FROM sqlite_master WHERE type='table'")}
        if "session_v2" in tables:
            query = """
                SELECT type AS role, time_created,
                       json_extract(data, '$.text') AS text,
                       (SELECT json_group_array(json_extract(c.value, '$.text'))
                        FROM json_each(m.data, '$.content') c
                        WHERE json_extract(c.value, '$.type') = 'text') AS blocks
                FROM session_message m WHERE session_id = ? AND type IN ('user', 'assistant')
                AND (coalesce(json_extract(data, '$.text'), '') != '' OR EXISTS (
                    SELECT 1 FROM json_each(m.data, '$.content') c
                    WHERE json_extract(c.value, '$.type') = 'text'
                    AND coalesce(json_extract(c.value, '$.text'), '') != ''))
                ORDER BY seq DESC LIMIT 6
            """
        elif {"message", "part"} <= tables:
            query = """
                SELECT json_extract(m.data, '$.role') AS role, m.time_created,
                       NULL AS text,
                       (SELECT json_group_array(text) FROM (
                            SELECT json_extract(p.data, '$.text') AS text FROM part p
                            WHERE p.message_id = m.id AND p.session_id = m.session_id
                            AND json_extract(p.data, '$.type') = 'text'
                            AND coalesce(json_extract(p.data, '$.synthetic'), 0) = 0
                            ORDER BY p.time_created, p.id)) AS blocks
                FROM message m WHERE m.session_id = ?
                AND json_extract(m.data, '$.role') IN ('user', 'assistant')
                AND EXISTS (SELECT 1 FROM part p WHERE p.message_id = m.id AND p.session_id = m.session_id
                            AND json_extract(p.data, '$.type') = 'text'
                            AND coalesce(json_extract(p.data, '$.synthetic'), 0) = 0
                            AND coalesce(json_extract(p.data, '$.text'), '') != '')
                ORDER BY m.time_created DESC, m.id DESC LIMIT 6
            """
        else:
            raise ValueError("This OpenCode message-store format is not supported yet.")
        rows = list(db.execute(query, (session,)))
        return [{"role": r["role"], "timestamp": r["time_created"],
                 "text": "\n\n".join(t for t in ([r["text"]] if r["text"] else json.loads(r["blocks"]))
                                     if isinstance(t, str))} for r in reversed(rows)]


def session_preview(client, session, home):
    if not re.fullmatch(r"[A-Za-z0-9_-]{1,160}", session):
        raise ValueError("Invalid session ID.")
    if client == "cursor":
        return {"messages": [], "notice": "Cursor's local messages are encrypted. Resume this session to read them."}
    if client == "opencode":
        messages = opencode_preview(home, session)
    else:
        paths = list((home / "projects").glob(f"*/{session}.jsonl")) if client == "claude" else list((home / "sessions").rglob(f"*{session}.jsonl"))
        if not paths:
            raise ValueError("Saved transcript is unavailable. Refresh the session list.")
        messages = transcript_preview(max(paths, key=lambda p: p.stat().st_mtime), client)
    result = []
    for message in messages:
        text = message.get("text", "")
        if not isinstance(text, str) or not text.strip():
            continue
        if len(text) > 12000:
            text = text[:12000] + "\n[Message truncated]"
        result.append({"role": message["role"], "text": text, "timestamp": preview_date(message.get("timestamp"))})
    return {"messages": result, "notice": "Last six text messages. Long messages are truncated; transcript reads are limited to the last 4 MiB." if result else "No readable user or assistant text found in the saved preview window."}


def git_output(*args):
    try:
        return subprocess.run(("git",) + args, capture_output=True, text=True, timeout=15, check=True).stdout
    except (OSError, ValueError, subprocess.SubprocessError):
        return ""


def find_repository(cwd, projects):
    fallback = {"project": cwd, "worktree": ""}
    if not cwd:
        return fallback
    directory = Path(cwd)
    while not directory.is_dir():
        if directory.parent == directory:
            return fallback
        directory = directory.parent
    paths = git_output("-C", str(directory), "rev-parse", "--path-format=absolute",
                       "--show-toplevel", "--git-common-dir").strip().split("\n")
    if len(paths) != 2:
        return fallback
    worktree, common = paths
    if common not in projects:
        first = git_output("--git-dir", common, "worktree", "list", "--porcelain", "-z").partition("\0")[0]
        if not first.startswith("worktree ") or first == "worktree ":
            return fallback
        projects[common] = first[len("worktree "):]
    return {"project": projects[common], "worktree": worktree}


def attach_projects(rows):
    locations, projects = {}, {}
    for row in rows:
        cwd = row.get("cwd") or ""
        if cwd not in locations:
            locations[cwd] = find_repository(cwd, projects)
        row.update(locations[cwd])


def project_matches(row, query):
    project = row["project"].lower()
    name = Path(project).name
    return query.lower() in (project, name, name.removesuffix(".git"))


# Clients inject instructions, reminders, and command output as user text.
INJECTED_USER_TEXT = ("<", "# AGENTS.md instructions")


def written_blocks(event, client):
    if client == "claude":
        message = None if event.get("isSidechain") or event.get("isMeta") else event.get("message")
    else:
        payload = event.get("payload")
        message = payload if event.get("type") == "response_item" and isinstance(payload, dict) and payload.get("type") == "message" else None
    if not isinstance(message, dict) or message.get("role") not in ("user", "assistant"):
        return []
    content = message.get("content")
    if isinstance(content, str):
        content = [{"type": "text", "text": content}]
    if not isinstance(content, list):
        return []
    role = message["role"]
    return [(role, block["text"]) for block in content
            if isinstance(block, dict) and block.get("type") in ("text", "input_text", "output_text")
            and isinstance(block.get("text"), str) and block["text"].strip()
            and not (role == "user" and block["text"].lstrip().startswith(INJECTED_USER_TEXT))]


def transcript_written_text(paths, client, terms):
    # Lines without any term cannot match, so most of a large transcript is never parsed.
    needles = [term.encode() for term in terms] if all(term.isascii() for term in terms) else []
    for path in paths:
        data = path.read_bytes()
        lowered = data.lower()
        if needles and not all(needle in lowered for needle in needles):
            continue
        for line, low in zip(data.split(b"\n"), lowered.split(b"\n")):
            if needles and not any(needle in low for needle in needles):
                continue
            try:
                event = json.loads(line)
            except (ValueError, UnicodeDecodeError):
                continue
            if isinstance(event, dict):
                yield from written_blocks(event, client)


def opencode_written_text(home):
    path = home / "opencode/opencode.db"
    tables = {row["name"] for row in database_rows(path, "SELECT name FROM sqlite_master WHERE type = 'table'")}
    if "session_v2" in tables:
        query = """
            SELECT session_id, type AS role, json_extract(data, '$.text') AS text
            FROM session_message WHERE type IN ('user', 'assistant')
            UNION ALL
            SELECT m.session_id, m.type, json_extract(c.value, '$.text')
            FROM session_message m, json_each(m.data, '$.content') c
            WHERE m.type IN ('user', 'assistant') AND json_extract(c.value, '$.type') = 'text'
        """
    elif {"message", "part"} <= tables:
        query = """
            SELECT p.session_id, json_extract(m.data, '$.role') AS role, json_extract(p.data, '$.text') AS text
            FROM part p JOIN message m ON m.id = p.message_id AND m.session_id = p.session_id
            WHERE json_extract(p.data, '$.type') = 'text' AND coalesce(json_extract(p.data, '$.synthetic'), 0) = 0
        """
    else:
        return {}
    texts = {}
    for row in database_rows(path, query):
        if isinstance(row["text"], str) and row["text"].strip():
            texts.setdefault(row["session_id"], []).append((row["role"], row["text"]))
    return texts


def message_match(blocks, terms):
    found, best = set(), (0, "", "")
    for role, text in blocks:
        hits = {term for term in terms if term in text.lower()}
        found |= hits
        if len(hits) > best[0]:
            best = (len(hits), role, text)
    if found != set(terms):
        return None
    text = " ".join(best[2].split())
    lower = text.lower()
    start = max(0, min(lower.find(term) for term in terms if term in lower) - 40)
    return {"role": best[1], "text": ("…" if start else "") + text[start:start + 200], "untrusted": True}


def grep_rows(rows, query, sources):
    terms = query.lower().split()
    if not terms:
        return rows
    homes = {client: location.expanduser().resolve() for client, (_, location) in sources.items()}
    clients = {row["client"] for row in rows}
    transcripts = {}
    if "claude" in clients:
        for path in (homes["claude"] / "projects").glob("*/*.jsonl"):
            transcripts.setdefault(("claude", path.stem), []).append(path)
    if "codex" in clients:
        # Rollout file names end with the session's UUID.
        for path in (homes["codex"] / "sessions").rglob("*.jsonl"):
            transcripts.setdefault(("codex", path.stem[-36:]), []).append(path)
    opencode = opencode_written_text(homes["opencode"]) if "opencode" in clients else {}
    matched = []
    for row in rows:
        if row["client"] == "opencode":
            blocks = opencode.get(row["id"], [])
        else:
            blocks = transcript_written_text(transcripts.get((row["client"], row["id"]), []), row["client"], terms)
        match = message_match(blocks, terms)
        if match:
            row["match"] = match
            matched.append(row)
    return matched


def last_message(row, home):
    try:
        preview = session_preview(row["client"], row["id"], home)
    except (OSError, sqlite3.Error, ValueError) as error:
        return {"last_message": None, "notice": str(error)}
    if not preview["messages"]:
        return {"last_message": None, "notice": preview["notice"]}
    message = preview["messages"][-1]
    return {"last_message": {"role": message["role"], "date": message["timestamp"],
                             "text": message["text"][:500], "untrusted": True}}


def last_message_line(row):
    message = row["last_message"]
    if not message:
        return clean(" ".join(row["notice"].split()))[:120]
    return f"{message['role']}: {clean(' '.join(message['text'].split()))}"[:120]


def resume_command(row):
    client, session = row["client"], row["id"]
    args = {"codex": ["codex", "resume", session],
            "claude": ["claude", "--resume", session],
            "opencode": ["opencode", "--session", session],
            "cursor": ["cursor-agent", "--resume", session]}[client]
    command = shlex.join(args)
    return f"cd {shlex.quote(row['cwd'])} && {command}" if row["cwd"] else command


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("search", nargs="?", default="", help="Filter project, title, or session ID")
    parser.add_argument("--client", choices=("codex", "claude", "opencode", "cursor"))
    parser.add_argument("-n", "--limit", type=int, default=30, help="Rows to show (0 for all)")
    parser.add_argument("--oldest", action="store_true", help="Show oldest sessions first")
    parser.add_argument("--project", help="Only sessions in this repository, by name or full path (exact match, worktrees included)")
    parser.add_argument("--title", help="Only sessions whose title contains this text")
    parser.add_argument("--grep", metavar="TEXT", help="Only sessions whose saved user or assistant messages contain every word of TEXT (adds untrusted match text)")
    parser.add_argument("--scripted", action="store_true", help="Include sessions started by scripts (claude -p, codex exec)")
    parser.add_argument("--last-message", action="store_true", help="Include each session's last message (untrusted session text)")
    parser.add_argument("--commands", action="store_true", help="Include commands to resume sessions")
    parser.add_argument("--json", action="store_true", help="Print structured session metadata")
    parser.add_argument("--preview", metavar="SESSION_ID", help="Print the last six saved text messages as JSON (requires --client)")
    args = parser.parse_args()
    if args.limit < 0:
        parser.error("--limit must be zero or greater")
    home = Path.home()
    sources = {
        "codex": (codex_sessions, Path(os.environ.get("CODEX_HOME", home / ".codex"))),
        "claude": (claude_sessions, Path(os.environ.get("CLAUDE_CONFIG_DIR", home / ".claude"))),
        "opencode": (opencode_sessions, Path(os.environ.get("XDG_DATA_HOME", home / ".local/share"))),
        "cursor": (cursor_sessions, home / ".cursor"),
    }
    if args.preview:
        if not args.client:
            parser.error("--preview requires --client")
        try:
            print(json.dumps(session_preview(args.client, args.preview, sources[args.client][1].expanduser().resolve())))
            return 0
        except (OSError, sqlite3.Error, ValueError) as error:
            print(json.dumps({"messages": [], "notice": str(error)}))
            return 1
    rows = []
    failed = False
    for client, (read, location) in sources.items():
        if args.client and args.client != client:
            continue
        try:
            rows.extend(read(location.expanduser().resolve()))
        except (OSError, sqlite3.Error, ValueError) as error:
            print(f"agents: {client}: {error}", file=sys.stderr)
            failed = True
    if not args.scripted:
        # Only automation runs inside Claude's per-session temp directory.
        rows = [r for r in rows if not r.pop("scripted", False)
                and not re.match(r"^/(?:private/)?tmp/claude-\d+/", r.get("cwd") or "")]
    for row in rows:
        row.pop("scripted", None)
    rows = [r for r in rows if args.search.lower() in
            " ".join(str(r.get(k) or "") for k in ("title", "cwd", "id")).lower()]
    if args.title is not None:
        rows = [r for r in rows if args.title.lower() in str(r.get("title") or "").lower()]
    if args.project is not None:
        attach_projects(rows)
        rows = [r for r in rows if project_matches(r, args.project)]
    if args.grep is not None:
        rows = grep_rows(rows, args.grep, sources)
    rows.sort(key=lambda r: r["activity"], reverse=not args.oldest)
    rows = rows[:args.limit] if args.limit else rows
    for row in rows:
        row["last_activity"] = datetime.fromtimestamp(row["activity"], timezone.utc).astimezone().isoformat(timespec="seconds")
        row["resume"] = resume_command(row)
        if args.last_message:
            row.update(last_message(row, sources[row["client"]][1].expanduser().resolve()))
    if args.json:
        print(json.dumps(rows, indent=2))
    elif rows:
        print(f"{'LAST ACTIVITY (LOCAL)':26} {'CLIENT':9} {'PROJECT':24} TITLE / SESSION")
        for row in rows:
            date = datetime.fromtimestamp(row["activity"]).astimezone().strftime("%d/%m/%Y %H:%M:%S %Z")
            project = clean(Path(row["cwd"]).name) if row["cwd"] else "?"
            print(f"{date:26} {row['client']:9} {project[:24]:24} {clean(row['title'] or row.get('first_prompt'))[:65]} [{row['id']}]")
            if args.commands:
                print(f"  {row['resume']}")
            if "match" in row:
                print(f"  {row['match']['role']}: {clean(row['match']['text'])[:120]}")
            if args.last_message:
                print(f"  {last_message_line(row)}")
    else:
        print("No matching sessions.")
    return int(failed)


if __name__ == "__main__":
    sys.exit(main())
